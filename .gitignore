# ---- 构建产物 ----
/target/
**/*.rs.bk
*.pdb

# ---- 本地工具链（本机专用，不入库） ----
/.toolchain/

# ---- 临时文件（约定：一次性脚本/探针放 _tmp/） ----
/_tmp/

# ---- 运行时数据与日志（含录制内容，绝不入库） ----
/data/
/logs/
*.log

# ---- 凭据与密钥（安全规范：一律环境变量 / secrets.env） ----
.env
.env.*
!.env.example
*.pem
*.key
*credentials*
*secrets*
*_rsa
secrets.env
**/secrets.env

# ---- 构建缓存与产物 ----
dist/
build/
__pycache__/
*.py[cod]
.venv/
venv/

# ---- Python 可重建的二进制依赖（体积 263MB + 23.5MB，由 requirements.txt 重建）----
# 备份仓库只保存源码；这些目录留在本地不动，不参与提交。
/python/vendor/
/python/runtime/
# 运行态缓存（自动探测出来的音频设备名，非源码）
python/.audio_device

# ---- 录制/处理产生的大文件（防误入库）----
*.mp4
*.mkv
*.wav
*.avi

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
