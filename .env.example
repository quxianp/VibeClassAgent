# ============================================================================
# VibeClassAgent 环境变量示例
# ----------------------------------------------------------------------------
# 用法：复制本文件为 .env 并填入真实值；.env 已被 .gitignore 排除，绝不要提交。
# 安全规范：所有 token / webhook / password 一律走环境变量，禁止硬编码入库。
# ============================================================================

# ---- 运行身份 ----
# 多教师共用场景下的 profile 名；留空则使用当前 Windows 登录账户
VCA_PROFILE=

# ---- 数据与配置根目录 ----
# 留空则使用程序默认路径（Windows: %ProgramData%\<项目名>\）
VCA_DATA_DIR=
VCA_CONFIG_DIR=

# ---- 日志 ----
# 可选值：trace | debug | info | warn | error
RUST_LOG=info

# ---- 内容提取（模型 API，用户自填，OpenAI 兼容协议） ----
# 语音转写默认纯本地，不需要 Key；此项仅用于「要点提取」环节
VCA_LLM_BASE_URL=https://<你的模型服务地址>/v1
VCA_LLM_API_KEY=<在此填入你的 API Key>
VCA_LLM_MODEL=<模型名，例如 gpt-4o-mini / deepseek-chat>

# ---- 推送渠道（用户自选其一或全部） ----
# 企业微信机器人
VCA_WECOM_WEBHOOK=<企业微信机器人 Webhook 地址>
# 官方 QQ 机器人
VCA_QQ_APP_ID=<QQ 机器人 AppID>
VCA_QQ_APP_SECRET=<QQ 机器人 AppSecret>
# 第三方协议渠道（需自行评估风控风险）
VCA_WECHAT_PERSONAL_TOKEN=<第三方渠道 token>
VCA_PUSH_TARGET=<默认推送目标会话 ID>

# ---- 本地插件市场 ----
# 留空表示仅本地市场（不联网）
VCA_MARKETPLACE_REMOTE_URL=
