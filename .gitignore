# ---- 构建产物 ----
/target/
**/*.rs.bk
*.pdb

# ---- 本地工具链（本机专用，不入库） ----
/.toolchain/

# ---- 临时文件（约定：一次性脚本/探针放 _tmp/） ----
/_tmp/

# ---- 运行时数据与日志（含录制内容，绝不入库） ----
/data/
/logs/
*.log

# ---- 用户的真实配置与课表（**含个人信息，绝不入库**）----
# config/ 下只有 *.example.yaml 是给人看的模板，应当入库；
# 其余是程序运行期真正读写的那一份：
#   profiles/*/settings.yaml  —— 含 preview_token（长期有效的推送链接令牌）
#   schedule/current.yaml     —— 真实课表，含教师姓名
#   timetable/current.yaml    —— 真实作息时间表
#   archive/                  —— 历史版本
#   .initialized              —— 「已初始化」标记
# 这些都是**每台机器各不相同**的本机状态，进仓库既没意义、又泄露隐私。
# 踩坑记录：本轮差点把带教师姓名的课表和 preview_token 一起提交上去。
config/profiles/
config/schedule/
config/timetable/
config/.initialized

# ---- 凭据与密钥（安全规范：一律环境变量 / secrets.env） ----
.env
.env.*
!.env.example
*.pem
*.key
*credentials*
*_rsa
# 注意：`*secrets*` 是为了挡住 secrets.env / secrets.json 这类凭据文件，
# 但它会把源码里的 secrets.rs（凭据读写模块）一起误伤，导致该文件静默不入库。
# 所以必须补例外 —— 而且例外要写在规则**下面**才生效。
*secrets*
!secrets.rs
!**/secrets.rs
secrets.env
**/secrets.env

# ---- 构建缓存与产物 ----
dist/
build/
__pycache__/
*.py[cod]
.venv/
venv/

# ---- Python 可重建的二进制依赖（体积 263MB + 23.5MB，由 requirements.txt 重建）----
# 备份仓库只保存源码；这些目录留在本地不动，不参与提交。
/python/vendor/
/python/runtime/
# 运行态缓存（自动探测出来的音频设备名，非源码）
python/.audio_device

# ---- 录制/处理产生的大文件（防误入库）----
*.mp4
*.mkv
*.wav
*.avi

# ---- 第三方可执行体（体积大，不入库）----
# ffmpeg 静态构建约 98 MB，由 _tmp/fetch_ffmpeg.py 之类的取材脚本获取，
# 或由用户自行放置到 tools/ffmpeg/。
/tools/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
